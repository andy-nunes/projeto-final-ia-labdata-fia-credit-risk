# CredIA (segredo obrigatorio fora do repositório)
GEMINI_API_KEY=

# Overrides opcionais (precedencia: env > config/integrations.yaml > defaults internos)
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODEL_FALLBACKS=gemini-2.0-flash-lite,gemini-2.5-flash-lite

# Kaggle (opcional; alternativa ao arquivo ~/.config/fia-credit-risk/kaggle/kaggle.env)
KAGGLE_API_TOKEN=

# MinIO/Airflow (opcional; recomendado em ~/.config/fia-credit-risk/{minio,airflow})
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
AIRFLOW_SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW_CONN_MINIO_DEFAULT=aws://minioadmin:minioadmin@?host=http%3A%2F%2Fminio%3A9000
